# Copy to `.env` before `docker compose up`. Only LightRAG reads this file; the
# demo MCP server needs no configuration.
#
# LightRAG indexes and answers with a model, so it needs one LLM binding and one
# embedding binding. Two setups are given below — pick one, delete the other.

# ---------------------------------------------------------------------------
# Option A (default): OpenAI. Smallest download, needs an API key.
# ---------------------------------------------------------------------------
LLM_BINDING=openai
LLM_MODEL=gpt-5.4-mini
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=sk-replace-me

EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-small
# Must match the embedding model. text-embedding-3-small is 1536,
# text-embedding-3-large is 3072. Changing it later means re-indexing.
EMBEDDING_DIM=1536
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=sk-replace-me

# ---------------------------------------------------------------------------
# Option B: a local Ollama on the host. No API key, but pull the models first:
#   ollama pull qwen3:4b
#   ollama pull bge-m3
# ---------------------------------------------------------------------------
# LLM_BINDING=ollama
# LLM_MODEL=qwen3:4b
# LLM_BINDING_HOST=http://host.docker.internal:11434
#
# EMBEDDING_BINDING=ollama
# EMBEDDING_MODEL=bge-m3:latest
# EMBEDDING_DIM=1024
# EMBEDDING_BINDING_HOST=http://host.docker.internal:11434

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Require an X-API-Key on every LightRAG call. Leave unset for the tutorial; if
# you set it, put the same value in the Knowledge screen's API key field.
# LIGHTRAG_API_KEY=tutorial-key

# Host ports, if 9621 or 9700 are taken.
# LIGHTRAG_PORT=9621
# TRACKER_PORT=9700
