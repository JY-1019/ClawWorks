# Copy to `.env` before `docker compose up`. Only LightRAG reads this file; the
# demo MCP server needs no configuration.
#
# LightRAG indexes and answers with a model, so it needs one LLM binding and one
# embedding binding. This example uses remote APIs: no local model download.
# 이 폴더의 .env에 LLM/임베딩 API 키를 각각 입력하세요. Git에 올리지 마세요.
# This is not the repository-root .env or the Gateway's model configuration.

# ---------------------------------------------------------------------------
# OpenAI API (separately billed). Set both keys, even if using the same account.
# For a compatible API, change each host/model and the embedding dimension too.
# ---------------------------------------------------------------------------
LLM_BINDING=openai
LLM_MODEL=gpt-5.4-mini
LLM_BINDING_HOST=https://api.openai.com/v1
LLM_BINDING_API_KEY=

EMBEDDING_BINDING=openai
EMBEDDING_MODEL=text-embedding-3-small
# Must match the embedding model. text-embedding-3-small is 1536,
# text-embedding-3-large is 3072. Changing it later means re-indexing.
EMBEDDING_DIM=1536
EMBEDDING_BINDING_HOST=https://api.openai.com/v1
EMBEDDING_BINDING_API_KEY=

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# LightRAG server access key, NOT a model provider key. To enable API auth,
# generate a separate random value and enter it in Knowledge's API key field.
# Health remains public. These settings do not create a WebUI login account.
# LIGHTRAG_API_KEY=<random-server-key>
# WHITELIST_PATHS=/health

# Host ports, if 9621 or 9700 are taken.
# LIGHTRAG_PORT=9621
# TRACKER_PORT=9700
